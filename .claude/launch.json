{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev-testdb",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://mcpworkbench:dev_password@127.0.0.1:55432/mcpworkbench_dev",
        "ENCRYPTION_KEY=local-test-key-local-test-key-local-test-key",
        "BETTER_AUTH_SECRET=test-secret-test-secret-test-secret-123",
        "BETTER_AUTH_URL=http://localhost:3100",
        "SCHEDULER=off",
        "bun",
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "mock-llm",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "scripts/mock-llm.ts",
        "4010"
      ],
      "port": 4010
    },
    {
      "name": "mock-mcp-oauth",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MOCK_MCP_OAUTH=1",
        "bun",
        "scripts/mock-mcp.ts",
        "4030"
      ],
      "port": 4030
    },
    {
      "name": "mcp-bridge",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "scripts/mcp-bridge.ts",
        "--port",
        "8808",
        "--token",
        "bridge-test-token",
        "--",
        "bun",
        "scripts/mock-mcp.ts",
        "--stdio"
      ],
      "port": 8808
    }
  ]
}
