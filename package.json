{
  "name": "mcp-workbench",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "docker:dev": "docker compose -f docker/compose/docker-compose.dev.yml up -d",
    "docker:prod": "docker compose -f docker/compose/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/compose/docker-compose.yml down"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-alert-dialog": "1.2.0",
    "@radix-ui/react-collapsible": "1.2.0",
    "@radix-ui/react-dialog": "1.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.0",
    "@radix-ui/react-progress": "1.2.0",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.0",
    "@radix-ui/react-slider": "1.6.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.0",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "1.3.0",
    "@radix-ui/react-tooltip": "1.4.0",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "better-auth": "1.7.7",
    "child_process": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "^11.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
