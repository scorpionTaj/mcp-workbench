# Postgres (with pgvector). Matches docker/compose/docker-compose.dev.yml
DATABASE_URL="postgresql://mcpworkbench:dev_password@localhost:5432/mcpworkbench_dev"

# Required: encrypts stored API keys (AES-256-GCM). At least 32 chars.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Optional: Redis cache. Leave empty to skip caching.
REDIS_URL=""

# Optional: raises GitHub API rate limits for the MCP registry.
GITHUB_TOKEN=""

# Optional: server-wide fallback provider keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# Production compose only
POSTGRES_PASSWORD=""
