# Postgres (with pgvector). Matches docker/compose/docker-compose.dev.yml
DATABASE_URL="postgresql://mcpworkbench:dev_password@localhost:5432/mcpworkbench_dev"

# Required: encrypts stored API keys (AES-256-GCM). At least 32 chars.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# Required: auth. Secret: openssl rand -base64 32. URL: where the app is served.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails that become admins when they sign up (feedback admin, health details).
ADMIN_EMAILS=""

# Optional OAuth sign-in (callback: <BETTER_AUTH_URL>/api/auth/callback/<github|google>)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Allow provider base URLs on private/loopback networks (e.g. a LAN Ollama).
# Defaults to true outside production; keep false on a public deployment (SSRF).
ALLOW_PRIVATE_PROVIDER_URLS=""

# Optional: Redis cache and shared rate-limit counters (needed to run several app instances).
# Leave empty to skip caching and count rate limits in each instance's memory.
REDIS_URL=""

# Optional: set to "off" to stop this instance from running scheduled agents.
SCHEDULER=""

# Optional: Sentry project DSN for scrubbed client and server error monitoring.
SENTRY_DSN=""

# Optional: email for sign-up verification, password reset and notifications. Set RESEND_API_KEY
# (Resend) or SMTP_URL (e.g. smtps://user:pass@smtp.example.com:465). With neither, emails are
# skipped with a log line and "Forgot password?" is hidden.
RESEND_API_KEY=""
SMTP_URL=""
EMAIL_FROM="MCP Workbench <notifications@example.com>"

# Optional: "true" or "false" forces email verification on or off for email/password sign-in.
# Default: on when RESEND_API_KEY or SMTP_URL is set, off otherwise.
REQUIRE_EMAIL_VERIFICATION=""

# Optional: set to "off" to disable rate limiting (chat, compare, Studio, uploads, sign-in).
RATE_LIMIT=""

# Optional: where uploads are stored (default ./storage/uploads); they are served only to their owner.
# Ignored by the production compose stack, which pins it to the uploads volume.
UPLOAD_DIR=""

# Optional: store uploads in an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, Backblaze B2)
# instead of UPLOAD_DIR; needed to run several app instances. Keep the bucket private: files are
# still served only to their owner through /uploads/... Missing files are read from local disk;
# copy existing ones with: bun scripts/migrate-uploads.ts --to-s3
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Default us-east-1 (fine for R2 and MinIO; Backblaze needs its region, e.g. us-west-004).
S3_REGION=""
# For non-AWS services, e.g. https://<account>.r2.cloudflarestorage.com or http://minio:9000
S3_ENDPOINT=""
# "true" for path-style URLs (MinIO).
S3_FORCE_PATH_STYLE=""
# Optional key prefix, e.g. "uploads/".
S3_PREFIX=""

# Optional: raises GitHub API rate limits when importing skills and plugins (60 requests/hour without it).
GITHUB_TOKEN=""

# Optional: server-wide fallback provider keys, used by accounts that haven't added their own
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# Optional: who may fall back to those keys: "all" (default), "admins" or "off".
# With open sign-up, use "admins" or "off" so strangers can't spend your keys.
SERVER_KEYS=""

# Optional: per-user daily spend cap in USD on those keys (list price; admins exempt). Empty = no cap.
SERVER_KEYS_DAILY_LIMIT_USD=""

# Production compose only. The app container also loads this whole file; DATABASE_URL and UPLOAD_DIR
# are overridden there. Run compose with --env-file .env (bun run docker:prod does).
POSTGRES_PASSWORD=""
